# Copy this file to .env.local and fill in the values.
# On Netlify, add the same names under Site configuration → Environment variables.
# Never put real values in this file; it is committed to git.

# Contact form email (Resend: https://resend.com → API Keys)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: sender shown in the email
CONTACT_FROM_EMAIL=
